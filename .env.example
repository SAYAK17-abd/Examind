# ==============================================================================
# EXAMIND ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and adjust credentials before production deployment.
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL) ---
POSTGRES_DB=examind
POSTGRES_USER=examind_user
POSTGRES_PASSWORD=replace_with_strong_password_minimum_16_chars
DATABASE_URL=jdbc:postgresql://postgres:5432/examind

# --- SPRING BOOT BACKEND ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod
FLYWAY_ENABLED=true

# --- SECURITY & JWT ---
# JWT Secret MUST be at least 256 bits (32 bytes) long for HMAC-SHA256
JWT_SECRET=replace_with_secure_random_base64_or_alphanumeric_string_min_256_bits!
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS & DOMAINS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- STORAGE ---
UPLOAD_DIR=/app/uploads

# --- AI & OCR SERVICES ---
AI_SERVICE_URL=http://ai-service:8000
OCR_SERVICE_URL=http://ai-service:8000
AI_SERVICE_MOCK_MODE=false
OCR_SERVICE_MOCK_MODE=false
TESSERACT_CMD=tesseract
OCR_MAX_IMAGE_DIMENSION=3000

# --- LLM API KEYS (Optional for cloud LLM fallback; leave blank for local models) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- FRONTEND (Vite) ---
VITE_API_BASE_URL=/api

