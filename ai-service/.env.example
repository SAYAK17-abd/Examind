# EXAMIND AI Service Environment Configuration

APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security (Leave blank in local dev to bypass header validation)
AI_SERVICE_API_KEY=

# AI Provider Configuration ("mock", "gemini", "openai")
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# NLP & Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Multi-Signal Scoring Weights
WEIGHT_SEMANTIC=0.20
WEIGHT_CONCEPT=0.25
WEIGHT_CORRECTNESS=0.30
WEIGHT_COMPLETENESS=0.25

# Calibrated Confidence Thresholds
CONFIDENCE_AUTO_THRESHOLD=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.60

# Operations
AI_REQUEST_TIMEOUT=60
EVALUATION_VERSION=1.0
PROMPT_VERSION=rubric-evaluator-v1

